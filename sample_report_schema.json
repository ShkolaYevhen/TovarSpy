{
  "$defs": {
    "AdRecord": {
      "description": "Normalized active ad or discovered live product record.",
      "properties": {
        "ad_id": {
          "title": "Ad Id",
          "type": "string"
        },
        "page_name": {
          "title": "Page Name",
          "type": "string"
        },
        "landing_url": {
          "title": "Landing Url",
          "type": "string"
        },
        "days_running": {
          "minimum": 0,
          "title": "Days Running",
          "type": "integer"
        },
        "ad_creative_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ad Creative Image Url"
        },
        "active_ad_sets": {
          "default": 1,
          "minimum": 1,
          "title": "Active Ad Sets",
          "type": "integer"
        },
        "est_spend_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Est Spend Usd",
          "type": "number"
        },
        "countries": {
          "items": {
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "source": {
          "default": "meta",
          "title": "Source",
          "type": "string"
        },
        "is_live": {
          "default": true,
          "title": "Is Live",
          "type": "boolean"
        }
      },
      "required": [
        "ad_id",
        "page_name",
        "landing_url",
        "days_running"
      ],
      "title": "AdRecord",
      "type": "object"
    },
    "CoFounderEconomics": {
      "description": "Dual unit economics (UA COD vs Cross-border) and composite opportunity score.",
      "properties": {
        "ua_cod_net_profit_usd": {
          "default": 0.0,
          "title": "Ua Cod Net Profit Usd",
          "type": "number"
        },
        "ua_cod_roi_pct": {
          "default": 0.0,
          "title": "Ua Cod Roi Pct",
          "type": "number"
        },
        "ua_return_drag_usd": {
          "default": 0.0,
          "title": "Ua Return Drag Usd",
          "type": "number"
        },
        "cross_border_net_profit_usd": {
          "default": 0.0,
          "title": "Cross Border Net Profit Usd",
          "type": "number"
        },
        "cross_border_roi_pct": {
          "default": 0.0,
          "title": "Cross Border Roi Pct",
          "type": "number"
        },
        "demand_velocity_score": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Demand Velocity Score",
          "type": "number"
        },
        "competition_score": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Competition Score",
          "type": "number"
        },
        "opportunity_score": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Opportunity Score",
          "type": "number"
        },
        "recommended_model": {
          "default": "UA_COD",
          "title": "Recommended Model",
          "type": "string"
        },
        "ua_wholesale_price_uah": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ua Wholesale Price Uah"
        },
        "ua_retail_price_uah": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ua Retail Price Uah"
        },
        "ua_net_profit_uah": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ua Net Profit Uah"
        }
      },
      "title": "CoFounderEconomics",
      "type": "object"
    },
    "LandingPageData": {
      "description": "Extracted product metadata and platform fingerprint from a landing page.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "final_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Url"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "fallback_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Image Url"
        },
        "platform": {
          "default": "Custom PHP",
          "title": "Platform",
          "type": "string"
        },
        "core_phrase": {
          "default": "",
          "title": "Core Phrase",
          "type": "string"
        },
        "model_code": {
          "default": "",
          "title": "Model Code",
          "type": "string"
        },
        "is_cod_lander": {
          "default": false,
          "title": "Is Cod Lander",
          "type": "boolean"
        },
        "cod_score": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Cod Score",
          "type": "integer"
        },
        "cod_signals": {
          "items": {
            "type": "string"
          },
          "title": "Cod Signals",
          "type": "array"
        },
        "is_generic_catalog": {
          "default": false,
          "title": "Is Generic Catalog",
          "type": "boolean"
        }
      },
      "required": [
        "url"
      ],
      "title": "LandingPageData",
      "type": "object"
    },
    "MarginResult": {
      "description": "Profitability calculation output for a product offer.",
      "properties": {
        "retail_price_usd": {
          "minimum": 0,
          "title": "Retail Price Usd",
          "type": "number"
        },
        "china_wholesale_price_usd": {
          "minimum": 0,
          "title": "China Wholesale Price Usd",
          "type": "number"
        },
        "shipping_cost_est_usd": {
          "default": 2.5,
          "title": "Shipping Cost Est Usd",
          "type": "number"
        },
        "est_cpa_usd": {
          "default": 6.0,
          "title": "Est Cpa Usd",
          "type": "number"
        },
        "net_margin_usd": {
          "title": "Net Margin Usd",
          "type": "number"
        },
        "profitability_index": {
          "default": 0.0,
          "title": "Profitability Index",
          "type": "number"
        },
        "is_winner": {
          "default": false,
          "title": "Is Winner",
          "type": "boolean"
        }
      },
      "required": [
        "retail_price_usd",
        "china_wholesale_price_usd",
        "net_margin_usd"
      ],
      "title": "MarginResult",
      "type": "object"
    },
    "MarketplaceSignal": {
      "description": "Public marketplace demand, pricing, and seller saturation snapshot.",
      "properties": {
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "platform": {
          "default": "",
          "title": "Platform",
          "type": "string"
        },
        "country": {
          "default": "",
          "title": "Country",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "listing_count": {
          "default": 0,
          "minimum": 0,
          "title": "Listing Count",
          "type": "integer"
        },
        "sold_count": {
          "default": 0,
          "minimum": 0,
          "title": "Sold Count",
          "type": "integer"
        },
        "median_price": {
          "default": 0.0,
          "minimum": 0,
          "title": "Median Price",
          "type": "number"
        },
        "min_price": {
          "default": 0.0,
          "minimum": 0,
          "title": "Min Price",
          "type": "number"
        },
        "max_price": {
          "default": 0.0,
          "minimum": 0,
          "title": "Max Price",
          "type": "number"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "median_price_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Median Price Usd",
          "type": "number"
        },
        "sold_velocity_score": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Sold Velocity Score",
          "type": "number"
        },
        "seller_density": {
          "default": 0,
          "minimum": 0,
          "title": "Seller Density",
          "type": "integer"
        },
        "seller_count": {
          "default": 0,
          "minimum": 0,
          "title": "Seller Count",
          "type": "integer"
        },
        "review_velocity": {
          "default": 0.0,
          "minimum": 0,
          "title": "Review Velocity",
          "type": "number"
        },
        "top_sample_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Sample Url"
        },
        "status": {
          "default": "empty",
          "title": "Status",
          "type": "string"
        },
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "MarketplaceSignal",
      "type": "object"
    },
    "SupplierOffer": {
      "description": "Matched wholesale supplier offer (UA local wholesale or legacy 1688/Alibaba).",
      "properties": {
        "supplier_name": {
          "title": "Supplier Name",
          "type": "string"
        },
        "product_title": {
          "title": "Product Title",
          "type": "string"
        },
        "product_url": {
          "title": "Product Url",
          "type": "string"
        },
        "wholesale_price_rmb": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wholesale Price Rmb",
          "type": "number"
        },
        "wholesale_price_usd": {
          "minimum": 0,
          "title": "Wholesale Price Usd",
          "type": "number"
        },
        "wholesale_price_uah": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wholesale Price Uah"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "years_on_1688": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Years On 1688"
        },
        "moq": {
          "default": 1,
          "minimum": 1,
          "title": "Moq",
          "type": "integer"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "source": {
          "default": "ua_wholesale",
          "title": "Source",
          "type": "string"
        },
        "supplier_type": {
          "default": "",
          "title": "Supplier Type",
          "type": "string"
        },
        "sales_count_text": {
          "default": "",
          "title": "Sales Count Text",
          "type": "string"
        },
        "match_score": {
          "default": 0.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "match_label": {
          "default": "",
          "title": "Match Label",
          "type": "string"
        },
        "is_live": {
          "default": true,
          "title": "Is Live",
          "type": "boolean"
        }
      },
      "required": [
        "supplier_name",
        "product_title",
        "product_url",
        "wholesale_price_usd"
      ],
      "title": "SupplierOffer",
      "type": "object"
    },
    "TelegramDropOffer": {
      "description": "Wholesale dropship offer parsed from a public Ukrainian Telegram channel.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "post_url": {
          "title": "Post Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "image_url": {
          "default": "",
          "title": "Image Url",
          "type": "string"
        },
        "drop_price_uah": {
          "default": 0.0,
          "minimum": 0,
          "title": "Drop Price Uah",
          "type": "number"
        },
        "rrc_price_uah": {
          "default": 0.0,
          "minimum": 0,
          "title": "Rrc Price Uah",
          "type": "number"
        },
        "drop_price_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Drop Price Usd",
          "type": "number"
        },
        "rrc_price_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Rrc Price Usd",
          "type": "number"
        },
        "in_stock": {
          "default": true,
          "title": "In Stock",
          "type": "boolean"
        },
        "supplier_contact": {
          "default": "",
          "title": "Supplier Contact",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "post_url",
        "title"
      ],
      "title": "TelegramDropOffer",
      "type": "object"
    }
  },
  "description": "Complete end-to-end analysis report for a single ad/product candidate.",
  "properties": {
    "ad": {
      "$ref": "#/$defs/AdRecord"
    },
    "landing": {
      "$ref": "#/$defs/LandingPageData"
    },
    "suppliers": {
      "items": {
        "$ref": "#/$defs/SupplierOffer"
      },
      "title": "Suppliers",
      "type": "array"
    },
    "best_supplier": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupplierOffer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "margin": {
      "$ref": "#/$defs/MarginResult"
    },
    "marketplace_signals": {
      "items": {
        "$ref": "#/$defs/MarketplaceSignal"
      },
      "title": "Marketplace Signals",
      "type": "array"
    },
    "tg_offers": {
      "items": {
        "$ref": "#/$defs/TelegramDropOffer"
      },
      "title": "Tg Offers",
      "type": "array"
    },
    "economics": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoFounderEconomics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_diagnostics": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Diagnostics",
      "type": "object"
    },
    "category": {
      "default": "",
      "title": "Category",
      "type": "string"
    },
    "competitor_advertisers": {
      "default": 1,
      "minimum": 0,
      "title": "Competitor Advertisers",
      "type": "integer"
    },
    "total_matching_ads": {
      "default": 1,
      "minimum": 0,
      "title": "Total Matching Ads",
      "type": "integer"
    },
    "cumulative_active_days": {
      "default": 0,
      "minimum": 0,
      "title": "Cumulative Active Days",
      "type": "integer"
    },
    "est_spend_usd": {
      "default": 0.0,
      "minimum": 0,
      "title": "Est Spend Usd",
      "type": "number"
    },
    "spend_basis": {
      "default": "",
      "title": "Spend Basis",
      "type": "string"
    },
    "competitor_ads": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Competitor Ads",
      "type": "array"
    },
    "wholesale_match_status": {
      "default": "",
      "title": "Wholesale Match Status",
      "type": "string"
    },
    "wholesale_match_note": {
      "default": "",
      "title": "Wholesale Match Note",
      "type": "string"
    },
    "analyzed_at": {
      "format": "date-time",
      "title": "Analyzed At",
      "type": "string"
    }
  },
  "required": [
    "ad",
    "landing",
    "margin"
  ],
  "title": "AnalyzedProductReport",
  "type": "object"
}
